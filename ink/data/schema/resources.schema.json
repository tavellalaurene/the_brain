{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resources.schema.json",
  "title": "Ressources pour se faire aider",
  "description": "Numéros et liens d'aide, pour une région. verified : date à laquelle chaque numéro et lien a été vérifié sur le site officiel (le build avertit au-delà de 6 mois).",
  "type": "object",
  "required": [
    "region",
    "verified",
    "intro",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "region": {
      "type": "string"
    },
    "verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "intro": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "label",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "category": {
            "enum": [
              "detresse",
              "parler",
              "consulter",
              "ailleurs"
            ]
          },
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "pattern": "^[0-9-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
